# =========================================================
#  智枢套件 (multi-agent) .gitignore
#  原则：只提交源码与配置模板，虚拟环境 / 依赖 / 模型权重 /
#        密钥 / 运行日志 / 数据卷 一律不入库。
# =========================================================

# ---------- Python 虚拟环境与构建产物 ----------
.venv/
venv/
env/
ENV/
.python-version
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------- Node.js ----------
node_modules/
.npm/
.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# ---------- 环境变量与密钥（重要！切勿提交） ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.yaml

# ---------- 模型权重（体积过大，请按手册从 ModelScope / HuggingFace 单独下载） ----------
apps/data-agent/docker-dataagent/embedding/
*.bin
*.safetensors
*.onnx
*.gguf
*.pt
*.pth
*.ckpt

# ---------- 运行日志与临时文件 ----------
logs/
*.log
temp-files/
*.tmp
*.bak

# ---------- 本机运行时文件（含会话 token / 端口占用态，一律不入库） ----------
apps/workbench/.session-store.json

# ---------- 数据库 / 向量库本地数据卷 ----------
volumes/
data/
docker-dataagent/mysql/data/
docker-dataagent/es/data/
docker-dataagent/qdrant/data/
*.sqlite
*.sqlite3
*.db

# ---------- IDE ----------
.idea/
*.iml
.vscode/
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
